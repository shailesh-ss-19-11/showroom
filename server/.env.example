PORT=8080
DB_URL=jdbc:postgresql://localhost:5434/showroom_java
DB_USERNAME=showroom
DB_PASSWORD=showroom

JWT_SECRET=change-this-to-a-long-random-string

CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:8080

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@varexa.in
ADMIN_PASSWORD=Admin@123

# File storage for bike photos: "local" (default, stores files on this server's disk)
# or "garage" (S3-compatible object storage via Garage).
STORAGE_TYPE=local

# Only used when STORAGE_TYPE=local. Absolute path recommended in production so
# uploads survive redeploys (defaults to ~/.showroom/uploads if unset).
LOCAL_STORAGE_DIR=/var/lib/showroom/uploads

# Only used when STORAGE_TYPE=garage.
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_REGION=garage
GARAGE_BUCKET=bike-photos
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
